# Keep a machine's GWToolbox progress flowing to the GW1 Build Planner.
#
#   cp gw1-upload.py ~/.local/bin/
#   cp gw1-upload.service ~/.config/systemd/user/
#   systemctl --user enable --now gw1-upload
#
# Pair first (see README.md) — without a token the service exits immediately
# and says so.

[Unit]
Description=GW1 Build Planner: upload GWToolbox completion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/gw1-upload.py --watch --interval 300
Restart=on-failure
RestartSec=60
# It reads one file and talks to one host; it has no business doing more.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/gw1-build-planner

[Install]
WantedBy=default.target
